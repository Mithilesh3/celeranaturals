# Firebase web app configuration (use a dedicated Firebase project for each environment)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin service account. SERVER ONLY - no NEXT_PUBLIC prefix, never
# imported from a client component. Project settings > Service accounts >
# Generate new private key. Keep the \n escapes in FIREBASE_PRIVATE_KEY.
# Used for: verifying Firebase ID tokens on /api routes, and writing orders to
# Firestore with privileged access so a browser can never mark an order paid.
# FIREBASE_PROJECT_ID is optional: it falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin panel allowlist. SERVER ONLY - never NEXT_PUBLIC. Comma-separated email
# addresses that may access /admin, matched against the email on a Firebase ID
# token verified by the Admin SDK. Empty or malformed means no admins, and every
# admin endpoint then fails closed with 403. Passwords are never stored here:
# they live in Firebase Authentication only.
ADMIN_EMAILS=celeranatural@gmail.com

# Product image uploads use Cloud Storage for Firebase. The bucket must exist
# before uploads work; Cloud Storage requires the Blaze plan, which is a
# billing change and is NOT enabled. Until a bucket is provisioned the admin
# product form says so and offers the repository media library instead, and
# /api/admin/media/upload returns 503 rather than losing a file. Image bytes
# are never stored in Firestore — only a path or URL is.
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app

# OPTIONAL. Delivery estimate window in business days, e.g. 5-7 or a single
# number. Leave unset and every order page honestly says "Delivery estimate
# unavailable" instead of showing a guessed date. SERVER ONLY: the window is
# computed in the API and sent as a value, so there is no NEXT_PUBLIC copy.
# There is no courier API integration; this is a configured promise, not a
# live prediction.
# DELIVERY_ESTIMATE_DAYS=5-7

# Razorpay. SERVER ONLY - the secret must never reach the browser. The key id is
# returned to the client by /api/orders/create, so it needs no NEXT_PUBLIC copy.
# Use test-mode keys (rzp_test_...) only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. Signs the raw webhook body.
RAZORPAY_WEBHOOK_SECRET=
